    {
      "id": "el88",
      "type": "text",
      "x": 633.0,
      "y": 1188.0,
      "width": 538.1999999999999,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 796872,
      "version": 1,
      "versionNonce": 760824,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚠  STP is off and forward-delay is 0 — this bridge forwards blindly\n   and will NOT break a loop. Cut it INTO links. Two ports patched to\n   the same switch and VLAN is a broadcast storm, not a blocked port.\n\n⚠  VERIFY ON THE GW7400: if these 5 ports sit behind a DSA switch\n   chip, the kernel can offload bridging to the chip and port-to-port\n   frames never reach the CPU — ntopng would see only uplink traffic.",
      "originalText": "⚠  STP is off and forward-delay is 0 — this bridge forwards blindly\n   and will NOT break a loop. Cut it INTO links. Two ports patched to\n   the same switch and VLAN is a broadcast storm, not a blocked port.\n\n⚠  VERIFY ON THE GW7400: if these 5 ports sit behind a DSA switch\n   chip, the kernel can offload bridging to the chip and port-to-port\n   frames never reach the CPU — ntopng would see only uplink traffic.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
