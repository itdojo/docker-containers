      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "POSITION=ext\nbridge0        addressless — an inline sensor with an\n               IP on the monitored segment is a target\nLOCAL_NETS     the WAN prefix (203.0.113.0/29), never\n               your LAN — this wire is post-NAT\nWEB_BIND       mgmt IP, or 127.0.0.1 + SSH tunnel\n               wildcard = REFUSED by host-setup.sh\nmDNS           off — no announcing on the dirty side\ndefault route  none, so images are side-loaded:\n               docker save … | ssh host 'docker load'",
      "originalText": "POSITION=ext\nbridge0        addressless — an inline sensor with an\n               IP on the monitored segment is a target\nLOCAL_NETS     the WAN prefix (203.0.113.0/29), never\n               your LAN — this wire is post-NAT\nWEB_BIND       mgmt IP, or 127.0.0.1 + SSH tunnel\n               wildcard = REFUSED by host-setup.sh\nmDNS           off — no announcing on the dirty side\ndefault route  none, so images are side-loaded:\n               docker save … | ssh host 'docker load'",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
