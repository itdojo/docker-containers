      "versionNonce": 748078,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "POSITION=int\nbridge0        DHCP lease  (dhcp-identifier: mac, so a\n               MAC reservation is actually honoured)\nLOCAL_NETS     your internal subnets, ALL of them\n               192.168.1.0/24,192.168.20.0/24,10.10.0.0/16\nWEB_BIND       0.0.0.0  — warned, then allowed\n               http://<hostname>.local:3000/\nmDNS           on  — MulticastDNS=yes in the drop-in\ndefault route  via bridge0 → compose pull works\n               host-setup.sh waits 45s for the lease first",
      "originalText": "POSITION=int\nbridge0        DHCP lease  (dhcp-identifier: mac, so a\n               MAC reservation is actually honoured)\nLOCAL_NETS     your internal subnets, ALL of them\n               192.168.1.0/24,192.168.20.0/24,10.10.0.0/16\nWEB_BIND       0.0.0.0  — warned, then allowed\n               http://<hostname>.local:3000/\nmDNS           on  — MulticastDNS=yes in the drop-in\ndefault route  via bridge0 → compose pull works\n               host-setup.sh waits 45s for the lease first",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "lineHeight": 1.25,
