# Plex Media Server — environment (example)
# Copy to .env and edit. .env is gitignored at the repo root.

# Claim token from https://plex.tv/claim — valid 4 minutes, one use.
# Only needed for the first start; the server stays claimed afterwards.
# Leave empty to claim manually at http://<host>:32400/web instead.
PLEX_CLAIM=

# The server name shown in Plex clients is NOT settable from here — the image's
# PLEX_PREFERENCE_* hook does not apply it. Set it once against the running server:
#   TOKEN=$(grep -o 'PlexOnlineToken="[^"]*"' config/Library/Application\ Support/Plex\ Media\ Server/Preferences.xml | cut -d'"' -f2)
#   curl -X PUT "http://localhost:32400/:/prefs?FriendlyName=dojoPlex&X-Plex-Token=$TOKEN"

# Host path holding the movies/ folder. Bind-mounted read-only at /media inside
# the container, so the Movies library is /media/movies. Exists only while the
# drive is mounted, so a missing drive stops the container instead of emptying the library.
MEDIA_PATH=/mnt/media/plexmedia

# Owner of ./config and the Plex process. Match the host user that owns this directory.
PLEX_UID=1000
PLEX_GID=1000

TZ=America/New_York
