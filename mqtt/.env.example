# Mosquitto broker stack (Lab 01) — example environment
#
# Copy to .env and edit to taste.  These values are read inside the
# container by healthcheck.sh, which runs `mosquitto_pub -u "$MQTT_USER"
# -P "$MQTT_PASSWORD"` against localhost:1883 every 30s.  The credentials
# must match a user that exists in ./data/mqtt_users.txt (created with
# `docker exec mosquitto mosquitto_passwd ...` per Lab 01).
#
# Use a dedicated low-privilege account for the healthcheck so the
# password is not also a publishing account that could be misused.

MQTT_USER=healthchecker
MQTT_PASSWORD=changeme
